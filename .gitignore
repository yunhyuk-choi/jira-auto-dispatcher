# --- 로컬 설정 (실토큰/계정ID 포함) ---
config/config.yaml

# --- 런타임 영속/작업 산출물 ---
# ⚠️ gitignore 에서 `#` 는 **줄 첫 칸**에서만 주석이다 — 패턴 뒤에 붙이면 그 텍스트까지
#    패턴의 일부가 되어 **아무것도 무시하지 않는다.** 실제로 아래 `secrets/` 는 그렇게
#    무력화돼 있었다(시크릿 **값** 디렉토리가 추적 가능한 상태였다). 그래서 설명은
#    전부 패턴 위 줄로 올린다.
state/
# 사용자 시크릿 파일(값) — 절대 추적 금지
state/secrets/
# 등록 사용자(운영 데이터, 온보딩으로 채워짐)
state/registry.json
# 컨테이너 마운트용 시크릿 파일(값)
secrets/
# 설치 마법사가 모은 답변(중단·재개용). 시크릿 값은 없지만 그 조직의 URL·프로젝트 키·
# 계정이 들어 있으므로 추적하지 않는다.
setup-answers.json
# 풀 퍼미션 동의 증서(app/setup_consent.py). 시크릿 값은 없지만 **사람 이름과 그 사람의
# 원문**이 들어간다. 그리고 이건 이 머신에서 그 사람이 동의했다는 개인 기록이지 팀이
# 공유할 설정이 아니다 — 다른 머신에 복사해 재사용하면 그 순간 자기 승인이 된다.
setup-consent.json
# 설치 관문 `discover` 의 조회 결과(JSON). 시크릿 **값**은 없지만 그 조직의 accountId ·
# 커스텀필드 id 전량 · 라벨 목록 · 상태/전이 이름 같은 **내부 메타데이터**가 통째로 들어
# 있다. 실수로 커밋되면 공개 레포에 조직 구조가 그대로 드러난다. 룰북
# (skill-templates/.../SKILL.template.md)과 CLI 예시가 쓰는 두 이름을 명시한다.
jira-discover.json
jira-fields.json
workspace/
.env

# --- 파이썬 ---
__pycache__/
*.pyc

# --- 런타임에 clone 되는 연동 레포 (앱이 소유하지 않음) ---
# 현행 배치는 공유 워크스페이스(`run.workspace_dir`) 하위 단일 클론이라 위의 `workspace/`
# 한 줄이 이미 전부 덮는다. 아래는 workspace_dir 를 안 쓰던 옛 배포가 리포 루트에 바로
# 클론해 둔 잔재용 — 그래서 **루트 앵커(`/`)** 로 정확히 리포 루트만 겨냥한다.
#
# ⚠️ 설계 문서 레포의 파생 디렉토리명이 `dataspace_docs` → 범용 `docs` 로 바뀌었지만,
#    여기에 `docs/` 를 (앵커 없이) 추가하면 **추적 중인 `docs/DESIGN-*.md` 가 통째로
#    무시된다.** 런타임 클론이 앉는 곳은 `<workspace_dir>/docs` 뿐이므로 워크스페이스
#    경로로만 명시한다(위 `workspace/` 와 중복이지만 의도를 문서로 남긴다).
/orchestrator/
/dlc-meta/
/dataspace_docs/
/workspace/docs/

# --- 로컬 Claude 세션/인증·스킬 (전부 개인 영역) ---
# ⚠️ 여기에 negation(`!.claude/skills/`)으로 구멍을 뚫지 말 것. `.claude/` 아래는 **그
#    머신의 개인 영역**이다 — 세션 인증·로컬 설정·머신별 절대경로가 섞이므로 공유하면
#    서로의 환경을 덮어쓴다. 프로젝트 스킬도 예외가 아니다: 리포가 추적하는 것은
#    `skill-templates/` 의 **템플릿**뿐이고, 실제 `.claude/skills/<이름>/SKILL.md` 는
#    클론한 사람이 `python -m app.setup skill` 로 자기 머신에 만든다(app/setup_skill.py).
#    짝 프레임워크 `ai-dlc-orchestrator` 의 SETTER S8.7 과 같은 규율(POLICY-TRACKING).
.claude/

# --- 추적 유지: 디렉토리 골격 표식 ---
!config/.gitkeep
!static/.gitkeep

# --- 로컬 설정 (실토큰/계정ID 포함) ---
config/config.yaml

# --- 런타임 영속/작업 산출물 ---
state/
state/secrets/           # 사용자 시크릿 파일(값) — 절대 추적 금지
state/registry.json      # 등록 사용자(운영 데이터, 온보딩으로 채워짐)
secrets/                 # 컨테이너 마운트용 시크릿 파일(값)
workspace/
.env

# --- 파이썬 ---
__pycache__/
*.pyc

# --- 런타임에 clone 되는 연동 레포 (앱이 소유하지 않음) ---
orchestrator/
dlc-meta/
dataspace_docs/

# --- 로컬 Claude 세션/인증 (볼륨으로 영속) ---
.claude/

# --- 추적 유지: 디렉토리 골격 표식 ---
!config/.gitkeep
!static/.gitkeep

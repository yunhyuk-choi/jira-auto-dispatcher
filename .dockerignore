# jira-auto-dispatcher — 빌드 컨텍스트 제외 (이미지에 굽지 말 것)
# COPY . . 로 들어가면 안 되는 것: VCS 메타·런타임 영속·시크릿·로컬 설정·런타임 clone 레포·테스트.

# --- VCS ---
.git
.gitignore
.gitattributes

# --- 런타임 영속/작업 산출물(볼륨으로 마운트; 이미지에 넣지 않음) ---
state/
workspace/

# --- 시크릿(값) — 절대 이미지에 굽지 말 것(ro 볼륨으로 주입) ---
secrets/
# .env 는 **값**을 담는다(CLAUDE_CODE_OAUTH_TOKEN). compose 가 호스트 프로젝트
# 디렉토리에서 읽어 environment 로 주입하므로 이미지 안에는 있을 이유가 없고, 있으면
# 그대로 이미지에 구운 시크릿이 된다. 있든 없든 무조건 제외한다.
.env
.env.*

# --- 런타임에 clone 되는 연동 레포(앱이 소유하지 않음) ---
# 위 workspace/ 가 현행 공유 워크스페이스 클론을 전부 덮는다. 아래는 옛 배포가 리포
# 루트에 클론해 둔 잔재용 — 루트 앵커로 컨텍스트 루트만 겨냥한다.
# ⚠️ `docs/` 를 앵커 없이 넣으면 리포가 추적하는 `docs/DESIGN-*.md` 까지 컨텍스트에서
#    빠진다. 런타임 클론 위치인 `<workspace_dir>/docs` 만 명시한다.
/orchestrator/
/dlc-meta/
/dataspace_docs/
/workspace/docs/

# --- 로컬 Claude 세션/인증(볼륨으로 영속) ---
.claude/

# --- 테스트(런타임 이미지에 불필요) ---
tests/

# --- 파이썬 캐시 ---
__pycache__/
*.pyc
.pytest_cache/

# --- 로컬 설정(실토큰/계정ID 포함) — 이미지에 굽지 말 것 ---
config/config.yaml
config/registry.json

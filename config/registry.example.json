{
  "_comment": "레지스트리 예시. 실운영본은 state/registry.json(gitignore)에 온보딩 UI(POST /onboard)로 채워진다. 이 파일은 스키마 참고용이며 시크릿 '값'은 담지 않는다(secrets_ref는 secrets.base_dir 상대 참조/시크릿키만).",
  "users": [
    {
      "username": "<username>",
      "display_name": "<username>",
      "jira_account_id": "<JIRA_ACCOUNT_ID>",
      "jira_email": "you@example.com",
      "google_chat_user_id": "<google-user-id (선택, 완료 알림 @멘션)>",
      "enabled": true,
      "autonomy_mode": "B",
      "permission_level": "bypass",
      "agent": "default",
      "per_repo": {
        "portal-frontend": "A",
        "portal-backend": "B"
      },
      "identity": {
        "git_name": "<git-name>",
        "git_email": "you@example.com"
      },
      "scope": {
        "projects": ["<PROJECT_KEY>"]
      },
      "container": {
        "name": "jad-worker-<username>",
        "status": "absent"
      },
      "secrets_ref": {
        "jira_token": "<username>/jira-token",
        "gitlab_token": "<username>/gitlab-token",
        "claude_oauth_token": "<username>/claude-oauth-token"
      }
    }
  ]
}
